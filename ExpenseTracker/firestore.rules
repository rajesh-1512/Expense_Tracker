rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated via localStorage
    // Since we're not using Firebase Auth, we allow all authenticated requests
    // In production, you should add additional validation
    
    // User profiles
    match /users/{userId} {
      // Allow anyone to read/write user profiles
      // In production with Firebase Auth, use: request.auth != null && request.auth.uid == userId
      allow read, write: if true;
      
      // User's transactions subcollection
      match /transactions/{transactionId} {
        // Allow read/write for all users
        // In production, add validation to ensure userId matches the authenticated user
        allow read, write: if true;
        
        // Validate transaction data structure on create
        allow create: if request.resource.data.keys().hasAll(['type', 'description', 'amount', 'category', 'date', 'deleted'])
                      && request.resource.data.type in ['income', 'expense']
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.deleted == false;
        
        // Allow soft delete (updating deleted field)
        allow update: if request.resource.data.deleted == true 
                      && request.resource.data.keys().hasAny(['deletedAt']);
      }
      
      // User's budgets subcollection
      match /budgets/{budgetId} {
        // Allow read/write for all users
        allow read, write: if true;
        
        // Validate budget data structure on write
        allow create: if request.resource.data.keys().hasAll(['period', 'category', 'limit'])
                      && request.resource.data.period in ['Weekly', 'Monthly', 'Yearly']
                      && request.resource.data.limit is number
                      && request.resource.data.limit > 0;
      }
      
      // User's recurring expenses subcollection
      match /recurringExpenses/{expenseId} {
        // Allow read/write for all users
        allow read, write: if true;
        
        // Validate recurring expense data structure on write
        allow create: if request.resource.data.keys().hasAll(['name', 'category', 'amount', 'frequency'])
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.frequency in ['Weekly', 'Monthly', 'Yearly'];
      }
    }
  }
}
